# Copy to `.env` for `docker compose up`. `.env` is ignored by Git. Placeholders only: never commit a real value.
# Compose passes every variable here to the API, so any variable in apps/api/.env.schema can be added
# (for example LOG_LEVEL=debug). DATABASE_URL and COOKIE_SECURE are fixed by docker-compose.yml.

# Password of the 7 seeded demo users. Required: the `migrate` service seeds them. Choose your own local value.
SEED_USER_PASSWORD=change-me-locally

# Host ports. Change them when 5432 or 8080 is taken on your machine.
DB_PORT=5432
APP_PORT=8080

# Shown by /api/v1/health as `version`. CI and the deploy set the full commit SHA.
APP_VERSION=dev
