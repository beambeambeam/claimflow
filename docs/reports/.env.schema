# Env of the report scripts. Copy .env.example to .env and fill it in.
# varlock loads it for bun run pdf, identity and capture-demo.
# @defaultRequired=infer @defaultSensitive=false
# ---

# Student 1 (GitHub Kiatisakk) and student 2 (GitHub beambeambeam), as printed
# on the front page. The last four digits of each ID are the short tag.
# @required @sensitive
STUDENT_1_NAME=
# @required @sensitive
STUDENT_1_ID=
# @required @sensitive
STUDENT_2_NAME=
# @required @sensitive
STUDENT_2_ID=

# Password of the seed users, the value used for `seed`. Only capture-demo
# needs it.
# @sensitive @required=false
SEED_USER_PASSWORD=

# Web app address for capture-demo.
# @type=url
BASE_URL=http://localhost:3000
