{
  "name": "karupan",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@types/node": "^26.6.5",
      "typescript": "^7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "vite-plus": "1.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "test:coverage": "vp run -r test:coverage",
    "check": "vp check && bun run --cwd apps/api check",
    "lint": "vp lint && bun run --cwd apps/api lint",
    "lint:fix": "vp lint --fix && bun run --cwd apps/api lint:fix",
    "lint:github": "vp lint --deny-warnings --format=github",
    "format": "vp fmt && bun run --cwd apps/api format",
    "format:check": "vp fmt --check && bun run --cwd apps/api format:check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "catalog:",
    "semantic-release": "25.0.9",
    "typescript": "catalog:",
    "ultracite": "^8.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
