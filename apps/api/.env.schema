# Env schema for apps/api. Run the API with `varlock run` so it gets the resolved values.
# `bun run generate` regenerates `env/env.go` from this file. It is off at runtime so the container never writes code.
# @defaultSensitive=false
# @defaultRequired=infer
# @generateGoEnv(path=env/env.go, auto=false)
# ---

# Gin validates GIN_MODE itself when the package loads. This only sets its default to release.
# @type=enum(debug, release, test)
GIN_MODE=release

# @type=port
PORT=8080

# PostgreSQL connection string, e.g. postgres://claimflow:claimflow@localhost:5432/claimflow?sslmode=disable
# @required @sensitive
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Adds `Secure` and the `__Host-` cookie prefix. Set false only for local HTTP.
# @type=boolean
COOKIE_SECURE=true

# bcrypt cost for password hashes. Never below 10 (NFR-01).
# @type=number(min=10, max=31, isInt=true)
BCRYPT_COST=12

# @type=enum(debug, info, warn, error)
LOG_LEVEL=info

# Release tag or git SHA. `/health` returns it as `version`.
APP_VERSION=dev
