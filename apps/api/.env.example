# Local development values for apps/api. Copy to `.env` (never committed); `.env.schema` documents each variable.
GIN_MODE=debug
PORT=8080
DATABASE_URL=postgres://claimflow:claimflow@localhost:5432/claimflow?sslmode=disable
COOKIE_SECURE=false
BCRYPT_COST=12
LOG_LEVEL=info
APP_VERSION=dev
# Leave unset in development: the Vite dev server serves the web app. The image sets it to /app/web.
# WEB_DIR=../web/dist
SEED_USER_PASSWORD=
